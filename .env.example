# Generate a long random value before deploying (for example: openssl rand -base64 48)
JWT_SECRET=replace-this-development-secret-before-production
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
# Production example (comma-separated origins are supported):
# CLIENT_ORIGIN=https://your-app.vercel.app,https://www.yourdomain.com
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-HOST/neondb?sslmode=require
# Optional in development. Required for emailed password resets in production.
# RESEND_API_KEY=re_...
# RESET_EMAIL_FROM=GasFlow <support@yourdomain.com>
